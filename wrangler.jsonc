// Cloudflare Workers configuration of the website: a Worker with static assets
// and no script, deployed by .github/workflows/deploy.yml with `wrangler
// deploy`. See "Deploying on Cloudflare Workers" in the README.
{
  "name": "gladys-website",
  "compatibility_date": "2026-11-19",
  // gladys-website.<subdomain>.workers.dev, and the preview of each pull
  // request at pr-<number>-gladys-website.<subdomain>.workers.dev (see
  // .github/workflows/preview.yml). Both are spelled out: if routes were
  // set, Wrangler would turn workers.dev off by default, and the preview URLs
  // with it.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    // What build.sh writes, with the _redirects and _headers files Cloudflare
    // applies itself.
    "directory": "./build",
    // /docs serves /docs/index.html at /docs/ and redirects /docs to it: the
    // site uses trailing slashes (trailingSlash in docusaurus.config.js).
    "html_handling": "auto-trailing-slash",
    // An unknown URL answers 404 with the nearest 404.html, so a missing page
    // under /fr/ gets the French one. Pages did this on its own; a Worker
    // answers an empty 404 unless told so.
    "not_found_handling": "404-page"
  }
  // No "routes" on purpose: gladysassistant.com is attached to the Worker in
  // the Cloudflare dashboard (Settings > Domains & Routes), and a deployment
  // leaves the domains of the Worker as they are when this file lists none.
  // Listing one here would make this file the reference: every deployment
  // would then replace the custom domains of the Worker with the ones listed,
  // and remove a domain added in the dashboard only.
}

// Cloudflare Workers configuration of the website: a Worker with static assets
// and no script, deployed by .github/workflows/deploy.yml with
//
//   wrangler deploy --config wrangler.workers.jsonc
//
// The file is deliberately not named wrangler.jsonc: Cloudflare Pages reads a
// Wrangler file of that name at the root of the repository as the
// configuration of the Pages project, and the Pages project keeps building
// this repository until the domain has moved to the Worker (see "Deploying on
// Cloudflare Workers" in the README).
{
  "name": "gladys-website",
  "compatibility_date": "2026-11-19",
  // gladys-website.<subdomain>.workers.dev, and the preview of each pull
  // request at pr-<number>-gladys-website.<subdomain>.workers.dev (see
  // .github/workflows/preview.yml). Both are spelled out: once routes are
  // set below, Wrangler would turn workers.dev off by default, and the
  // preview URLs with it.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    // What build.sh writes, with the _redirects and _headers files Cloudflare
    // applies itself.
    "directory": "./build",
    // /docs serves /docs/index.html at /docs/ and redirects /docs to it: the
    // site uses trailing slashes (trailingSlash in docusaurus.config.js).
    "html_handling": "auto-trailing-slash",
    // An unknown URL answers 404 with the nearest 404.html, so a missing page
    // under /fr/ gets the French one. Pages did this on its own; a Worker
    // answers an empty 404 unless told so.
    "not_found_handling": "404-page"
  },
  // The domains of the Worker. This list is the reference: every deployment
  // replaces the custom domains of the Worker with it, so a domain added in
  // the dashboard only (www., for instance) is removed by the next one. Add
  // it here as well.
  "routes": [
    { "pattern": "gladysassistant.com", "custom_domain": true }
  ]
}
